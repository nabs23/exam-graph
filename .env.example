APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=360

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

OPENAI_API_KEY=
VOYAGEAI_API_KEY=
AI_DEFAULT_FOR_EMBEDDINGS=voyageai
VOYAGEAI_EMBEDDING_MODEL=voyage-4
VOYAGEAI_EMBEDDING_DIMENSIONS=1024
AI_FILE_EMBEDDINGS_ENABLED=false
AI_FILE_EMBEDDINGS_PDF_PAGE_LIMIT=100
AI_FILE_EMBEDDINGS_BATCH_SIZE=8
AI_FILE_EMBEDDINGS_PDFINFO_TIMEOUT=10
AI_FILE_EMBEDDINGS_PDFTOTEXT_TIMEOUT=20
AI_FILE_EMBEDDINGS_TIMEOUT=40
AI_FILE_EMBEDDINGS_JOB_TRIES=3
AI_FILE_EMBEDDINGS_JOB_INITIAL_BACKOFF=10
AI_FILE_EMBEDDINGS_JOB_SECOND_BACKOFF=30
AI_FILE_EMBEDDINGS_JOB_TIMEOUT=120
AI_OFFICIAL_CURRICULUM_EXTRACTION_ENABLED=false
AI_OFFICIAL_CURRICULUM_PROVIDER=openai
AI_OFFICIAL_CURRICULUM_MODEL=
AI_OFFICIAL_CURRICULUM_MODELS=gpt-6-astra,gpt-6-sol,gpt-6-luna,gpt-6.1-sol
# Seconds to wait for extraction; 0 waits until OpenAI finishes.
AI_OFFICIAL_CURRICULUM_TIMEOUT=240
AI_OFFICIAL_CURRICULUM_REASONING_EFFORT=low
AI_OFFICIAL_CURRICULUM_MAX_CHARACTERS=120000
AI_OFFICIAL_CURRICULUM_JOB_TRIES=2
AI_OFFICIAL_CURRICULUM_JOB_INITIAL_BACKOFF=15
AI_OFFICIAL_CURRICULUM_JOB_SECOND_BACKOFF=45

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
